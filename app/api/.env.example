# Configuracao da API Trocai.
# Copie para .env e preencha os valores: cp .env.example .env
# O .env real NAO vai para o Git (esta no .gitignore).

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Obrigatorio, sem default. Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave-em-producao

# Em producao SEMPRE False.
DEBUG=True

# Lista separada por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# postgres (padrao) ou sqlite.
DB_ENGINE=postgres

DB_NAME=trocai
DB_USER=trocai
DB_PASSWORD=trocai_dev_2026
DB_HOST=localhost
DB_PORT=5432

# Vazio em dev. Em producao com Postgres gerenciado, use: require
DB_SSLMODE=

# Usado apenas quando DB_ENGINE=sqlite.
# SQLITE_NAME=db.sqlite3

# -----------------------------------------------------------------------------
# CORS / Frontend
# -----------------------------------------------------------------------------
# Origens do Next.js autorizadas a chamar a API. Lista separada por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Usado em redirecionamentos e links de email.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Em dev os emails sao impressos no console. Em producao, troque pelo backend SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# -----------------------------------------------------------------------------
# OAuth (login social)
# -----------------------------------------------------------------------------
# Ainda NAO sao lidas pelo settings.py — o login social nao esta implementado.
# Mantidas aqui como referencia do que sera necessario quando for.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
